<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::system">
                    <resource id="WdevAmar_LogViewer::logviewer" title="Log Viewer" sortOrder="10">
                        <resource id="WdevAmar_LogViewer::view" title="View Logs" sortOrder="10" />
                        <resource id="WdevAmar_LogViewer::download" title="Download Logs" sortOrder="20" />
                        <resource id="WdevAmar_LogViewer::delete" title="Delete Logs" sortOrder="30" />
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
